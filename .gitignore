# 功能：排除本地 IDE、Python 缓存和运行时缓存文件，保留项目代码与样本数据。

.idea/
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

*.egg-info/
build/
dist/

var/cache/*
!var/cache/.gitkeep
var/logs/*
!var/logs/.gitkeep

data/raw/eorzea_collection/metadata/errors.jsonl

# Generated dataset artifacts are kept local while the collector is still changing.
data/raw/eorzea_collection/html/**
!data/raw/eorzea_collection/html/.gitkeep
data/raw/eorzea_collection/images/**
!data/raw/eorzea_collection/images/.gitkeep
data/raw/eorzea_collection/metadata/**
!data/raw/eorzea_collection/metadata/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Local IDE, Python, build, and runtime cache files.
.idea/
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

*.egg-info/
build/
dist/

var/cache/*
!var/cache/.gitkeep
var/logs/*
!var/logs/.gitkeep

# Large or browser/runtime-generated artifacts stay local.
data/raw/eorzea_collection/html/**
!data/raw/eorzea_collection/html/.gitkeep
data/raw/eorzea_collection/images/**
!data/raw/eorzea_collection/images/.gitkeep

# Local safety backups created before in-place enrichment.
*.before_*

# Generated repair manifest; summary JSON keeps the durable QA result.
data/processed/eorzea_missing_images_manifest.jsonl
# Generated visual retrieval indexes and evaluation outputs.
data/indexes/**
!data/indexes/.gitkeep
data/samples/retrieval_eval.generated.jsonl
data/processed/retrieval_eval_results.json
data/processed/retrieval_eval_cross_view_results.json
data/processed/retrieval_eval_results.latest.json
data/processed/retrieval_eval_cross_view_results.latest.json
data/samples/retrieval_eval_images/**
data/processed/retrieval_eval_mild_results.json
data/processed/retrieval_eval_stress_results.json
data/processed/glamour_crop_embeddings*.npz
data/processed/glamour_matching_eval_results*.json
# Player-uploaded glamour pages and screenshots are local source caches.
data/raw/eorzea_collection/glamours/html/**
!data/raw/eorzea_collection/glamours/html/.gitkeep
data/raw/eorzea_collection/glamours/images/**
!data/raw/eorzea_collection/glamours/images/.gitkeep
# Generated pose/crop inspection outputs.
data/debug/**
